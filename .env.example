# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Database Configuration - Choose one based on environment

# DEVELOPMENT (SQLite) - No setup needed
DB_ENV=dev
# DATABASE_URL is auto-set to file:./prisma/dev.db by switch-db.js

# PRODUCTION (PostgreSQL) - Requires setup
# DB_ENV=prod
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Optional: Guild ID for guild-specific command deployment
# GUILD_ID=your_guild_id_here
