# Discord Bot Configuration
# DISCORD_TOKEN: Bot token from Discord Developer Portal (required)
DISCORD_TOKEN=your_bot_token_here

# DISCORD_CLIENT_ID: Application client ID from Discord Developer Portal (required)
DISCORD_CLIENT_ID=your_client_id_here

# Database Configuration - Choose one based on environment

# DB_ENV: Database environment selector (required)
#   - "dev": Uses SQLite for local development (file:./prisma/dev.db)
#   - "prod": Uses PostgreSQL for production (requires DATABASE_URL)
DB_ENV=dev

# DATABASE_URL: PostgreSQL connection string (optional)
#   - Leave empty for SQLite development mode
#   - For production PostgreSQL: postgresql://user:password@host:port/dbname
#   - Note: switch-db.js updates the Prisma schema provider based on DB_ENV,
#     but cannot persist DATABASE_URL across npm commands. Set this value
#     if deploying to production PostgreSQL.
# DATABASE_URL=

# GUILD_ID: Discord server ID for guild-specific command deployment (optional)
#   - Leave commented out to deploy commands globally (slower sync)
#   - Set to a specific guild ID to deploy only to that guild (faster for development)
# GUILD_ID=your_guild_id_here

# RAID_ROLES: Discord role IDs eligible for raid sign-ups (deprecated)
#   - Deprecated as of PR #15. Raid roles are now specified per-raid via /raid create roles:
#   - This variable is no longer used but may be read by legacy code paths.
# RAID_ROLES=role1_id,role2_id,role3_id

# RAID_LEADER_ROLES: Discord role IDs that can manage raids (optional)
#   - Comma-separated list of role IDs allowed to create/edit/delete raids
#   - If not set, only server administrators can manage raids
# RAID_LEADER_ROLES=role1_id,role2_id
