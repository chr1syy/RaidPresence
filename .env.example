# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Database
DB_ENV=dev
DATABASE_URL="file:./dev.db"

# Guild Configuration (OPTIONAL - Defaults for new guilds)
# Server admins should use /config commands to set these per-server
# These values are only used as defaults when a new guild joins

# Default roles for raid attendance (comma-separated role names or IDs)
RAID_ROLES=

# Default roles that can create and manage raids (comma-separated role names or IDs)
# Leave empty to allow anyone with ManageEvents permission
RAID_LEADER_ROLES=
