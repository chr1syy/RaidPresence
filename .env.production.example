# Production Environment Variables (Railway)
# Copy these variable names to Railway dashboard

# Required - Get from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id

# Optional - Defaults for new guilds (usually leave empty)
RAID_ROLES=
RAID_LEADER_ROLES=

# Database - Automatically set by Railway when you add PostgreSQL
# DO NOT manually set this in Railway!
# DATABASE_URL=postgresql://...
