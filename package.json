{
  "name": "raid-presence",
  "version": "0.1.0",
  "description": "Discord bot for WoW raid attendance management with reverse sign-up",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && prisma generate",
    "start": "npm run db:migrate:deploy && node dist/deploy-commands.js && node dist/index.js",
    "start:local": "node dist/index.js",
    "deploy": "tsx src/deploy-commands.ts",
    "deploy:commands": "node dist/deploy-commands.js",
    "db:generate": "node prisma/generate-schema.js --schema-only && prisma generate",
    "db:migrate": "node prisma/generate-schema.js",
    "db:prod-migrations": "node scripts/create-prod-migrations.js",
    "db:migrate:deploy": "node prisma/generate-schema.js --schema-only && prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:jest": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "discord",
    "bot",
    "wow",
    "raid",
    "attendance"
  ],
  "author": "chr1syy",
  "license": "Custom",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
