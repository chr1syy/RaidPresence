{
  "name": "raid-presence",
  "version": "0.2.0",
  "description": "Discord bot for WoW raid attendance management with reverse sign-up",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && prisma generate",
    "start": "prisma migrate deploy && node dist/deploy-commands.js && node dist/index.js",
    "start:local": "node dist/index.js",
    "deploy": "tsx src/deploy-commands.ts",
    "deploy:commands": "node dist/deploy-commands.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:jest": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "postinstall": "prisma generate",
    "e2e:test": "tsx scripts/e2e-test.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "wow",
    "raid",
    "attendance"
  ],
  "author": "chr1syy",
  "license": "Custom",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
