generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PremiumTier {
  FREE
  PREMIUM
}

model Guild {
  id              String   @id
  name            String
  raidRoles       String?  @default("") // DEPRECATED: Previously used for default raid attendance roles. No longer used as roles are now specified per-raid in /raid create. Keep only for backward compatibility with existing data. Consider removing in v2.0+
  raidLeaderRoles String   @default("") // Comma-separated role IDs or names who can create raids
  language        String   @default("en") // Language for bot messages (en, de)
  timezone        String   @default("UTC") // IANA zone for interpreting typed raid times (e.g. "Europe/Berlin"). DST-aware; see utils/timezoneHelper.ts
  timezoneOffset  Int      @default(0) // DEPRECATED, phase 1 of the IANA migration. Nothing reads this any more; it is kept written (guildTimezoneUpdate()) purely as a rollback path and is dropped in phase 2.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // NULL = the bot is currently in this guild; set = the bot is out (kicked, or the
  // guild was deleted). Rows are never removed, so this is the only thing that tells
  // a live install apart from a dead one — every guild count must filter on it.
  //
  // SEMANTICS: this is the timestamp at which the departure was *detected*, not
  // necessarily when it happened. A kick observed live via guildDelete lands within
  // seconds; one found by the startup reconciliation is stamped at boot time and may
  // be weeks late. Never read it as an exact churn date.
  leftAt          DateTime?

  // Archive system fields (Phase 2.4)
  archiveChannelId String?  // Guild's designated archive channel
  autoArchive      Boolean  @default(false) // Auto-archive on close?

  // Premium system (Phase 1.2)
  premiumTier            PremiumTier @default(FREE)
  premiumExpiresAt       DateTime?
  entitlementId          String?
  weeklyRaidCount        Int         @default(0)
  weeklyRaidCountResetAt DateTime?
  trialStartedAt         DateTime?

  raids Raid[]
  users UserPreference[]
  rolePreferences UserRolePreference[]
  teams Team[]

  // Every usage count and every candidate query filters on `leftAt` from here on.
  @@index([leftAt])
}

model Team {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  isDefault Boolean  @default(false) // Exactly one default ("Main") team per guild
  createdBy String // Discord user ID of the creator ("system" for auto-created default teams)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  raids Raid[]

  @@unique([guildId, name])
  @@index([guildId])
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String // Discord user ID
  guildId   String
  username  String
  wowClass  String? // e.g., "Warrior", "Mage", etc.
  wowSpec   String? // e.g., "Protection", "Fire", etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild      Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  attendance RaidAttendance[]

  @@unique([userId, guildId])
}

model Raid {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String // Channel where raid was created
  messageId   String? // Message ID of the raid embed
  raidDate    DateTime
  description String?
  roles       String   @default("") // Comma-separated role IDs or names used for this raid
  status      String   @default("open") // "open", "closed", "cancelled"
  createdBy   String // Discord user ID of raid leader
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Template/Clone fields
  templateName         String?   // Optional: save raid as template name
  isTemplate           Boolean   @default(false) // Is this a template?
  createdFromTemplateId String?  // Track which raid this was cloned from
  templateVersion      Int       @default(1) // Version for future template iterations
  clonedAt             DateTime? // When this raid was cloned from a template

  // Archive system fields (Phase 2.4)
  archivedAt       DateTime? // When raid was archived
  archiveChannelId String?   // Channel where archived message lives
  archiveMessageId String?   // Message ID of archived embed
  isPinned         Boolean   @default(false) // Is raid pinned/archived?

  // Weekly recurrence (retention). A series is a *chain*, not a separate table: every
  // instance points at the one it was generated from, so "does a successor already
  // exist" is a unique-index question rather than a bookkeeping problem.
  recurrenceRule         String?  // null = one-off, 'weekly' = generate the next instance on close
  recurrenceParentId     String?  @unique // the raid this one was generated from; UNIQUE = at most one successor, which is what makes the scheduler idempotent
  recurrenceActive       Boolean  @default(true) // false = series stopped/paused; only meaningful with recurrenceRule set
  recurrenceSilentStreak Int      @default(0) // consecutive auto-generated instances with zero player interaction, ending at this one

  // Post-raid nudge (one per raid, non-recurring raids only)
  nudgeSentAt    DateTime? // set once the nudge went out — the "exactly one nudge" guard
  nudgeMessageId String?   // nudge message, cleared when the button is used or expires

  recurrenceParent Raid? @relation("RaidRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  // One-to-one because of the UNIQUE above: the successor generated from this raid.
  recurrenceChild  Raid? @relation("RaidRecurrence")

  // Team assignment (RPTIER Phase 2) — backfilled to the guild's default team
  teamId String

  guild      Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  team       Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  attendance RaidAttendance[]

  @@index([guildId, status])
  @@index([raidDate])
  @@index([guildId, raidDate])
  @@index([guildId, archivedAt])
  @@index([teamId, status])
  @@index([teamId, raidDate])
  // The scheduler's series pass scans exactly this predicate every 2 minutes.
  @@index([recurrenceRule, recurrenceActive, status])
}

model UserRolePreference {
  id        String   @id @default(cuid())
  userId    String // Discord user ID
  guildId   String
  roleId    String // Discord role ID from the raid's roles
  wowClass  String? // e.g., "Warrior", "Mage", etc.
  wowSpec   String? // e.g., "Protection", "Fire", etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId, roleId])
}

model RaidAttendance {
  id          String    @id @default(cuid())
  raidId      String
  userId      String // Discord user ID
  username    String
  status      String    @default("attending") // "attending", "opted_out", or "late"
  wowClass    String? // Class at time of raid (can differ from preference)
  wowSpec     String? // Spec at time of raid
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Raid notes feature (Phase 2.3)
  optoutReason  String? // Player's reason for opting out
  playerNote    String? // Player's comment on their status
  notedAt       DateTime? // When note was added

  // Last time the *player* touched this row (opt-in/out, late, class pick). Distinct
  // from `respondedAt`, which only tracks attendance answers and feeds response-time
  // analytics. This one answers a different question — "did anybody engage with this
  // raid at all?" — which is what pauses a zombie recurring series.
  interactedAt DateTime?

  raid           Raid            @relation(fields: [raidId], references: [id], onDelete: Cascade)
  userPreference UserPreference? @relation(fields: [userId, guildId], references: [userId, guildId])
  guildId        String

  // Denormalized team assignment (RPTIER Phase 2) — inherited from the raid, kept
  // relation-free on purpose so cascades stay driven by Raid alone
  teamId String

  @@unique([raidId, userId])
  @@index([raidId, status])
  @@index([userId, guildId, status])
  @@index([teamId, userId, status])
}
